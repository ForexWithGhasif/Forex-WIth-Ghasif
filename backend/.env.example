PORT=5000
CLIENT_ORIGIN=*

# Email (get a key at https://resend.com/api-keys — free tier, no domain verification required to start)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=onboarding@resend.dev
CONTACT_EMAIL=where-contact-emails-go@gmail.com

# Client area (sign up / sign in) — provision a free Postgres database
# (Vercel Postgres, from your Vercel project's Storage tab, is the smoothest
# option since it auto-fills DATABASE_URL for you) and generate JWT_SECRET
# with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
JWT_SECRET=your-long-random-secret
